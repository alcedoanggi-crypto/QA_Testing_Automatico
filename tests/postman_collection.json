    {
      "name": "Dashboard - Métricas (Bearer Token, 200 OK)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status code es 200 OK\", function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "",
              "const body = pm.response.json();",
              "",
              "pm.test(\"Contiene las métricas principales\", function () {",
              "    [\"total_tests\", \"pass_rate\", \"bugs_found\", \"avg_response_time_ms\", \"recent_executions\"].forEach(function (key) {",
              "        pm.expect(body).to.have.property(key);",
              "    });",
              "});",
              "",
              "pm.test(\"Pass Rate entre 0 y 100\", function () {",
              "    pm.expect(body.pass_rate).to.be.within(0, 100);",
              "});",
              "",
              "pm.test(\"Listado de ejecuciones recientes con estructura válida\", function () {",
              "    pm.expect(body.recent_executions).to.be.an(\"array\");",
              "    if (body.recent_executions.length) {",
              "        pm.expect(body.recent_executions[0]).to.include.all.keys(\"run_id\", \"suite\", \"status\", \"executed_at\", \"trigger\");",
              "    }",
              "});",
              "",
              "pm.test(\"Incluye estado de la automatización\", function () {",
              "    pm.expect(body.automation).to.include.all.keys(\"enabled\", \"interval_minutes\", \"running\");",
              "});"
            ]
          }
        }
      ],
      "request": {
        "auth": {
          "type": "bearer",
          "bearer": [
