  ],
  "item": [
    {
      "name": "Auth - Login exitoso (200 OK)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status code es 200 OK\", function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "",
              "pm.test(\"Content-Type es JSON\", function () {",
              "    pm.expect(pm.response.headers.get(\"Content-Type\")).to.include(\"application/json\");",
              "});",
              "",
              "const body = pm.response.json();",
              "",
              "pm.test(\"Respuesta contiene un token JWT válido\", function () {",
              "    pm.expect(body).to.have.property(\"token\").that.is.a(\"string\");",
              "    pm.expect(body.token.split(\".\")).to.have.lengthOf(3);",
              "});",
              "",
              "pm.test(\"Respuesta contiene datos del usuario\", function () {",
              "    pm.expect(body.user).to.eql({ name: \"Admin QA\", role: \"Lead QA\" });",
              "});",
              "",
              "pm.test(\"Tiempo de respuesta menor a 2000 ms\", function () {",
              "    pm.expect(pm.response.responseTime).to.be.below(2000);",
              "});",
              "",
              "// Extrae el token a variables de colección y entorno para las siguientes peticiones.",
              "if (body.token) {",
              "    pm.collectionVariables.set(\"token\", body.token);",
              "    if (pm.environment) { pm.environment.set(\"token\", body.token); }",
              "}"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Accept",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"{{email}}\",\n  \"password\": \"{{password}}\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": {
          "raw": "{{baseUrl}}/api/v1/auth/login",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "v1",
            "auth",
            "login"
          ]
        },
        "description": "Inicia sesión con credenciales válidas y guarda el token JWT en la variable {{token}}."
      },
      "response": []
    },
