    {
      "name": "Pruebas - Ejecutar pruebas automáticas del sistema",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status code es 200 OK\", function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "",
              "const body = pm.response.json();",
              "",
              "pm.test(\"Se generó un lote con casos ejecutados\", function () {",
              "    pm.expect(body.batch_id).to.match(/^LOTE-/);",
              "    pm.expect(body.total).to.be.above(0);",
              "    pm.expect(body.passed + body.failed).to.eql(body.total);",
              "});",
              "",
              "pm.test(\"Todos los casos automáticos pasaron\", function () {",
              "    pm.expect(body.failed).to.eql(0);",
              "});",
              "",
              "pm.test(\"Se registró una ejecución por suite\", function () {",
              "    pm.expect(body.runs).to.be.an(\"array\").that.is.not.empty;",
              "    body.runs.forEach(function (run) {",
              "        pm.expect(run.run_id).to.match(/^RUN-/);",
              "        pm.expect(run.trigger).to.eql(\"Manual\");",
              "    });",
              "});"
            ]
          }
        }
      ],
      "request": {
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{token}}",
              "type": "string"
            }
          ]
        },
        "method": "POST",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/v1/test-runs/execute",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "v1",
            "test-runs",
            "execute"
          ]
        },
        "description": "La aplicación ejecuta su batería de pruebas del sistema (login, seguridad, métricas, reportes y vistas) y registra los resultados. Devuelve 409 si ya hay un lote en curso."
      },
      "response": []
